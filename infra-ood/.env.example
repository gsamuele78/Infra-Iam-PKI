# infra-ood/.env.example — copy to .env on the OOD host and fill in.
# Reference: doc/infra-ood/CONFIGURATION.md. .env is gitignored (HARD RULE 8).

# Keycloak OIDC discovery endpoint and the client created for OOD
OIDC_ENDPOINT=https://sso.example.com/realms/master/.well-known/openid-configuration
OIDC_CLIENT_ID=ood-portal
OIDC_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET

# PKI: ood-init fetches the root CA from step-ca and checks it against FINGERPRINT
CA_URL=https://ca.example.com:9000
FINGERPRINT=REPLACE_WITH_ROOT_CA_SHA256_FINGERPRINT
