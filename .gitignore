# .gitignore for Infra-IAM-PKI
# Rule: real configuration and every secret stay on the deployed host.
# Committed templates are *.env.example (production placeholders) and
# *.env.sandbox (lab-only values). See docs/maintenance-guide.md.

# Environment files (secrets). Any `.env`, `.env.*`, `*.env`, `.env copy`.
.env
.env.*
*.env
*.env copy
.env copy*
!.env.example
!.env.sandbox
!*.env.template

# Data directories (bind mounts created by deploy scripts / init containers)
step_data/
db_data/
logs/
keycloak_data/
caddy_data/
certs/

# Secrets and key material
secrets/
*.key
*.crt
*.pem
*.p12
private_key

# Generated scripts / tokens
*_join_pki.env

# Backups
backups/

# Vagrant state and lab output (never commit: contains machine private keys)
.vagrant/
tests/lab/artifacts/
tests/lab/logs/

# Python / tool caches
__pycache__/
*.pyc
node_modules/

# System files
.DS_Store

# Local agent/tool state (Serena LSP cache, memories, per-user config; OhMyOpenCode plans)
.serena/
.omo/

# Live oauth2-proxy config holds client_secret/cookie_secret; template is oauth2-proxy.cfg.example
infra-rstudio/config/oauth2-proxy.cfg
