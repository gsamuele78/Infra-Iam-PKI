# .gitignore for Infra-IAM-PKI
# Rule: real configuration and every secret stay on the deployed host.
# Committed templates are *.env.example (production placeholders) and
# *.env.sandbox (lab-only values). See docs/maintenance-guide.md.

# Environment files (secrets). Any `.env`, `.env.*`, `*.env`, `.env copy`.
.env
.env.*
*.env
*.env copy
.env copy*
!.env.example
!.env.sandbox
!.env.sandbox.example
!*.env.template

# Data directories (bind mounts created by deploy scripts / init containers)
step_data/
db_data/
logs/
keycloak_data/
caddy_data/
certs/

# Secrets and key material
secrets/
*.key
*.crt
*.pem
*.p12
private_key

# Generated scripts / tokens
*_join_pki.env

# Backups
backups/

# Vagrant state and lab output (never commit: contains machine private keys)
.vagrant/
tests/lab/artifacts/
tests/lab/logs/

# Python / tool caches
__pycache__/
*.pyc
node_modules/

# System files
.DS_Store

# Local agent/tool state (Serena LSP cache, memories, per-user config; OhMyOpenCode plans).
# .serena/project.yml is shared on purpose (language servers, ignores); the rest stays local.
.serena/*
!.serena/project.yml
.omo/
.claude/settings.local.json

# Live oauth2-proxy config holds client_secret/cookie_secret; template is oauth2-proxy.cfg.example
infra-rstudio/config/oauth2-proxy.cfg
# Site values (real e-mails, AD topology). Same set R-studioConf de-tracked in
# 0981563; the tracked templates are the matching *.example files.
infra-rstudio/config/admin_recipients.txt
infra-rstudio/config/user_email_map.txt
infra-rstudio/config/scopri_progetti_known.conf
infra-rstudio/config/lib_kerberos_setup.vars.conf
infra-rstudio/config/join_domain_sssd.vars.conf
infra-rstudio/config/join_domain_samba.vars.conf
infra-rstudio/config/site/
